# Copy this file to .env and fill it in. .env is git-ignored; never commit it.

# --- Arcade ---
# Create a key in Arcade Studio: Settings -> API keys (https://studio.arcade.ai/settings/api-keys)
# Optional: leave it empty and let each person add their own key after signing in.
ARCADE_API_KEY=

# Arcade rejects requests without a descriptive User-Agent. Put a contact email here.
CONTACT_EMAIL=you@example.com

# --- Sign-in ---
# Accounts that exist on every start, as name:password pairs separated by commas. The first is the admin.
# This is the default sign-in. Change it before anyone else can reach the server.
WORKBENCH_USERS=admin:admin

# Let people create their own accounts on the sign-in page (true or false).
ALLOW_SIGNUP=true

# Let signed-in people use the keys in this file when they have none of their own (true or false).
# Sharing a key means sharing its bill.
SHARE_HOST_KEYS=true

# Encrypts API keys people store. If unset, a random secret is written to data/secret.key.
WORKBENCH_SECRET=

# --- AI models (optional host keys people can borrow) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Storage (optional) ---
# A SQLite file. Defaults to data/workbench.db.
DATABASE_PATH=

PORT=8787
